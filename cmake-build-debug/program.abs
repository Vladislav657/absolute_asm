program-    stArt   0x8000      / Начало программы, задаем имя и начальный адрес
a-          byte    41          / Формируем байтовую константу (символ 'A')
b-          BYTE    42
c-          word    1000        / Формируем константу, занимающую одно слово (1000)
            resb    5           / Резервируем 5 байт для данных
            REsw    3           / Резервируем 3 слова для данных
            eND     program
